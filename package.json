{
  "name": "papermint",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A focused frontend for Paperless-ngx.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "test:e2e": "playwright test",
    "demo": "npm run build && PAPERMINT_SAMPLES=1 node mock-server/server.mjs",
    "samples": "node mock-server/samples/build.mjs"
  },
  "dependencies": {
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.57.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/majicmaj/papermint.git"
  }
}
